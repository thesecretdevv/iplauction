{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "railpack",
    "buildCommand": "npm ci --prefix auction-backend"
  },
  "deploy": {
    "startCommand": "npm start --prefix auction-backend",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  }
}
